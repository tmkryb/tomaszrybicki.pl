---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = allArticles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title="Artykuły — Tomasz Rybicki"
  description="Praktyczne spojrzenie na architekturę, dług technologiczny, platformy frontendowe i podejmowanie sensownych decyzji technicznych."
>
  <Nav />
  <main class="pt-32 pb-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-14">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-ink-muted hover:text-ink text-sm mb-8 transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          Strona główna
        </a>
        <div class="section-label">Artykuły</div>
        <h1 class="text-3xl md:text-4xl font-bold text-ink mb-4 leading-tight">
          Praktyczne spojrzenie na technologię
        </h1>
        <p class="text-ink-muted text-lg max-w-xl leading-relaxed">
          Piszę o architekturze, długu technicznym, platformach frontendowych i podejmowaniu
          sensownych decyzji technicznych. Bez teorii dla teorii.
        </p>
      </div>

      {articles.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {articles.map(article => (
            <a href={`/artykuly/${article.slug}`} class="card group flex flex-col">
              <div class="flex flex-wrap gap-2 mb-3">
                {article.data.tags?.slice(0, 2).map(tag => (
                  <span class="text-xs font-mono text-ink-muted border border-border px-2 py-0.5 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="text-ink font-semibold text-base mb-2 leading-snug group-hover:text-accent transition-colors flex-1">
                {article.data.title}
              </h2>
              <p class="text-ink-muted text-sm leading-relaxed mb-4">{article.data.description}</p>
              <time class="text-ink-subtle text-xs font-mono" datetime={article.data.publishDate.toISOString()}>
                {formatDate(article.data.publishDate)}
              </time>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 border border-border rounded-2xl bg-bg-card">
          <p class="text-ink-muted">Artykuły wkrótce.</p>
        </div>
      )}
    </div>
  </main>
  <Footer />
</Layout>

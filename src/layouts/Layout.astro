---
interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  canonical?: string;
}

const {
  title = 'Tomasz Rybicki — Konsultant Technologiczny & Architekt',
  titleEn = 'Tomasz Rybicki — Technology Consultant & Architect',
  description = 'Pomagam firmom upraszczać złożone systemy, porządkować architekturę i redukować dług technologiczny. Senior consultant i architect z 14-letnim doświadczeniem.',
  descriptionEn = 'I help companies simplify complex systems, streamline architecture, and reduce technical debt. Senior consultant and architect with 14+ years of experience.',
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <script is:inline>
      (function () {
        // Language detection: URL param > localStorage > default (pl)
        var params = new URLSearchParams(window.location.search);
        var urlLang = params.get('lang');
        var lang;
        if (urlLang === 'en' || urlLang === 'pl') {
          lang = urlLang;
          localStorage.setItem('lang', lang);
        } else {
          lang = localStorage.getItem('lang') || 'pl';
        }
        document.documentElement.lang = lang;
        // Sync URL if not default
        if (lang !== 'pl' && !urlLang) {
          var url = new URL(window.location);
          url.searchParams.set('lang', lang);
          window.history.replaceState({}, '', url);
        }

        // Theme detection
        var t = localStorage.getItem('theme') || 'auto';
        if (t === 'dark' || (t === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }

        // Update document title and meta based on language
        if (lang === 'en') {
          var enTitle = document.querySelector('meta[name="title-en"]');
          var enDesc = document.querySelector('meta[name="description-en"]');
          if (enTitle) document.title = enTitle.content;
          if (enDesc) {
            var descMeta = document.querySelector('meta[name="description"]');
            var ogDesc = document.querySelector('meta[property="og:description"]');
            if (descMeta) descMeta.content = enDesc.content;
            if (ogDesc) ogDesc.content = enDesc.content;
          }
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="title-en" content={titleEn} />
    <meta name="description" content={description} />
    <meta name="description-en" content={descriptionEn} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-bg text-ink font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: 255 255 255;
    --color-bg-surface: 248 250 252;
    --color-bg-card: 255 255 255;
    --color-bg-elevated: 241 245 249;
    --color-accent: 99 102 241;
    --color-accent-light: 129 140 248;
    --color-accent-dark: 79 70 229;
    --color-ink: 15 23 42;
    --color-ink-muted: 71 85 105;
    --color-ink-subtle: 148 163 184;
    --color-border: 226 232 240;
    --color-border-light: 203 213 225;
    --color-nav: 30 41 59;
    --color-nav-border: 51 65 85;
    --color-grid-line: 203 213 225;
  }

  .dark {
    --color-bg: 2 6 23;
    --color-bg-surface: 15 23 42;
    --color-bg-card: 30 41 59;
    --color-bg-elevated: 51 65 85;
    --color-accent: 129 140 248;
    --color-accent-light: 165 180 252;
    --color-accent-dark: 99 102 241;
    --color-ink: 248 250 252;
    --color-ink-muted: 148 163 184;
    --color-ink-subtle: 71 85 105;
    --color-border: 51 65 85;
    --color-border-light: 71 85 105;
    --color-nav: 2 6 23;
    --color-nav-border: 15 23 42;
    --color-grid-line: 51 65 85;
  }

  /* i18n: hide inactive language */
  html:not([lang="en"]) [data-lang="en"],
  html[lang="en"] [data-lang="pl"] {
    display: none !important;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  ::selection {
    background-color: rgb(var(--color-accent) / 0.15);
    color: rgb(var(--color-ink));
  }

  ::-webkit-scrollbar {
    width: 5px;
  }
  ::-webkit-scrollbar-track {
    background: rgb(var(--color-bg-elevated));
  }
  ::-webkit-scrollbar-thumb {
    background: rgb(var(--color-border-light));
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgb(var(--color-ink-subtle));
  }

  .grid-bg {
    background-image:
      linear-gradient(rgb(var(--color-grid-line) / 0.6) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--color-grid-line) / 0.6) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-bg-surface));
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-ink-muted));
    margin-bottom: 1.5rem;
  }

  .section-label::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    background: rgb(var(--color-accent));
    border-radius: 50%;
  }

  .card {
    background: rgb(var(--color-bg-card));
    border: 1px solid rgb(var(--color-border));
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 1px 3px rgb(var(--color-ink) / 0.04);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .card:hover {
    border-color: rgb(var(--color-border-light));
    box-shadow: 0 4px 16px rgb(var(--color-ink) / 0.08);
    transform: translateY(-2px);
  }

  .prose-content h1,
  .prose-content h2,
  .prose-content h3 {
    color: rgb(var(--color-ink));
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-content h1 { font-size: 2rem; }
  .prose-content h2 { font-size: 1.5rem; }
  .prose-content h3 { font-size: 1.2rem; }

  .prose-content p {
    color: rgb(var(--color-ink-muted));
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .prose-content ul,
  .prose-content ol {
    color: rgb(var(--color-ink-muted));
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .prose-content li {
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }

  .prose-content strong {
    color: rgb(var(--color-ink));
    font-weight: 600;
  }

  .prose-content a {
    color: rgb(var(--color-accent));
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-content blockquote {
    border-left: 3px solid rgb(var(--color-accent));
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: rgb(var(--color-ink-muted));
    font-style: italic;
  }

  .prose-content code {
    font-family: 'JetBrains Mono', monospace;
    background: rgb(var(--color-bg-surface));
    border: 1px solid rgb(var(--color-border));
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.875em;
    color: rgb(var(--color-accent));
  }
</style>

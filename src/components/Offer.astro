---
const offers = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: 'Konsultacje techniczne',
    desc: 'Jednorazowe lub cykliczne sesje, na których omawiamy konkretne problemy techniczne, decyzje architektoniczne lub wyzwania organizacyjne. Dla liderów technicznych szukających zewnętrznego punktu widzenia.',
    type: 'jednorazowe / cykliczne',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
    title: 'Audyt architektury / długu technicznego',
    desc: 'Głęboka analiza systemu: architektura, zależności, ryzyka, dług technologiczny. Dostarczam raport z priorytetyzowanymi rekomendacjami i planem działań — nie listą problemów bez kontekstu.',
    type: 'projekt z określonym zakresem',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
    title: 'Warsztaty techniczne',
    desc: 'Interaktywne warsztaty dla zespołu lub liderów. Tematyka dopasowana do potrzeb: architektura, dług technologiczny, frontend platform, integracje, podejmowanie decyzji technicznych.',
    type: 'dla zespołu',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="23" y1="11" x2="23" y2="17"/><line x1="20" y1="14" x2="26" y2="14"/></svg>`,
    title: 'Wsparcie architektoniczne dla zespołu',
    desc: 'Regularne wsparcie dla zespołu lub liderów technicznych: przeglądy kodu i architektury, uczestnictwo w kluczowych decyzjach, mentoring. Działam jako external expert, nie zastępuję wewnętrznych zasobów.',
    type: 'ciągła współpraca',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    title: 'Advisory / External CTO',
    desc: 'Długoterminowa rola external advisora lub fractional CTO. Pomagam w budowaniu strategii technicznej, rekrutacji liderów, ocenie kierunku technicznego i kluczowych decyzjach. Dla firm produktowych i scale-upów.',
    type: 'długoterminowa współpraca',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
    title: 'Doraźne wsparcie decyzyjne',
    desc: 'Masz przed sobą ważną decyzję architektoniczną i chcesz ją omówić z kimś, kto widział różne konteksty? Jednorazowe konsultacje przy konkretnym wyborze — wybór technologii, zmiany strukturalne, migracje.',
    type: 'jednorazowe',
  },
];
---

<section id="oferta" class="py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-14">
      <div class="section-label">Oferta współpracy</div>
      <h2 class="text-3xl md:text-4xl font-bold text-ink mb-4 leading-tight">
        Jak możemy pracować razem
      </h2>
      <p class="text-ink-muted text-lg max-w-xl leading-relaxed">
        Współpraca może być jednorazowa, projektowa lub długoterminowa.
        Mogę wejść jako external expert — nie muszę zastępować całego zespołu,
        żeby pomóc mu działać lepiej.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {offers.map(offer => (
        <div class="card flex flex-col gap-4">
          <div class="flex items-start justify-between gap-3">
            <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center text-accent flex-shrink-0">
              <Fragment set:html={offer.icon} />
            </div>
            <span class="text-xs font-mono text-ink-subtle border border-border px-2 py-1 rounded-full whitespace-nowrap">
              {offer.type}
            </span>
          </div>
          <div>
            <h3 class="text-ink font-semibold text-base mb-2 leading-snug">{offer.title}</h3>
            <p class="text-ink-muted text-sm leading-relaxed">{offer.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 p-8 border border-border bg-bg-card rounded-2xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-ink font-semibold text-lg mb-1">Nie wiesz, od czego zacząć?</h3>
        <p class="text-ink-muted text-sm">Napisz krótko, co chcesz osiągnąć lub jaki problem chcesz rozwiązać. Razem ustalimy, co ma sens.</p>
      </div>
      <a
        href="#kontakt"
        class="flex-shrink-0 inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white font-medium px-6 py-3 rounded-lg transition-colors text-sm"
      >
        Porozmawiajmy
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

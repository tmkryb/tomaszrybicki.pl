---
const year = new Date().getFullYear();

const links = [
  { href: '/#uslugi', label: 'W czym pomagam' },
  { href: '/#jak-pracuje', label: 'Jak pracuję' },
  { href: '/#o-mnie', label: 'O mnie' },
  { href: '/#case-studies', label: 'Case studies' },
  { href: '/artykuly', label: 'Artykuły' },
  { href: '/#kontakt', label: 'Kontakt' },
];
---

<footer class="border-t border-border bg-bg-surface">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <a href="/" class="text-ink font-semibold text-lg tracking-tight">
          Tomasz Rybicki<span class="text-accent">.</span>
        </a>
        <p class="text-ink-muted text-sm mt-1 max-w-xs leading-relaxed">
          Konsultant technologiczny & Software Architect.<br />
          Pomagam upraszczać złożone systemy.
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-2">
        {links.map(link => (
          <a
            href={link.href}
            class="text-ink-muted hover:text-ink text-sm transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-10 pt-6 border-t border-border flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-ink-subtle text-sm">
        &copy; {year} Tomasz Rybicki. Wszelkie prawa zastrzeżone.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="https://www.linkedin.com/in/tomasz-rybicki/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-subtle hover:text-accent transition-colors"
          aria-label="LinkedIn"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="mailto:tmkryb@gmail.com"
          class="text-ink-subtle hover:text-accent transition-colors"
          aria-label="Email"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

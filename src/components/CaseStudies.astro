---
import { getCollection } from 'astro:content';

const allCases = await getCollection('case-studies', ({ data }) => !data.draft);
const cases = allCases.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<section id="case-studies" class="py-24 md:py-32 bg-bg-surface relative overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-20"></div>
  <div class="relative max-w-6xl mx-auto px-6">
    <div class="mb-14">
      <div class="section-label">Case studies</div>
      <h2 class="text-3xl md:text-4xl font-bold text-ink mb-4 leading-tight">
        Przykładowe problemy, które rozwiązuję
      </h2>
      <p class="text-ink-muted text-lg max-w-xl leading-relaxed">
        Konkretne sytuacje z praktyki. Bez nazw firm, z naciskiem na problem, podejście i rezultat.
      </p>
    </div>

    {cases.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {cases.map(cs => (
          <a href={`/case-studies/${cs.slug}`} class="card group flex flex-col">
            <div class="flex items-center gap-2 mb-4">
              {cs.data.tags?.map(tag => (
                <span class="text-xs font-mono text-accent bg-accent/10 border border-accent/20 px-2 py-0.5 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
            <h3 class="text-ink font-semibold text-base mb-2 leading-snug group-hover:text-accent transition-colors">
              {cs.data.title}
            </h3>
            <p class="text-ink-muted text-sm leading-relaxed flex-1 mb-4">
              {cs.data.problem}
            </p>
            <div class="flex items-center gap-1.5 text-accent text-sm font-medium">
              Czytaj więcej
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <!-- Fallback static cards when no content yet -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          {
            tags: ['Frontend Platform'],
            title: 'Porządkowanie frontendu w organizacji wielozespołowej',
            problem: 'Kilka zespołów rozwijało osobne aplikacje bez wspólnych standardów. Każda miała własny bundler, własne komponenty, własne podejście do CSS. Integracja była koszmarem.',
          },
          {
            tags: ['Tech Debt', 'Architecture'],
            title: 'Redukcja długu technologicznego bez zatrzymywania delivery',
            problem: 'System e-commerce z 8-letnim długiem technicznym. Każda zmiana cennika zajmowała tygodnie. Biznes chciał nowych funkcji, zespół chciał rewrite\'a, który i tak by nie wyszedł.',
          },
          {
            tags: ['Integration', 'Distributed'],
            title: 'Uproszczenie architektury integracji w systemie B2B',
            problem: 'Sieć 12 systemów połączonych point-to-point. Każda zmiana w jednym systemie wymagała modyfikacji w trzech innych. Nikt nie wiedział, co na co wpływa.',
          },
        ].map(cs => (
          <div class="card flex flex-col opacity-80">
            <div class="flex items-center gap-2 mb-4">
              {cs.tags.map(tag => (
                <span class="text-xs font-mono text-accent bg-accent/10 border border-accent/20 px-2 py-0.5 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
            <h3 class="text-ink font-semibold text-base mb-2 leading-snug">{cs.title}</h3>
            <p class="text-ink-muted text-sm leading-relaxed flex-1 mb-4">{cs.problem}</p>
            <p class="text-ink-subtle text-xs font-mono">Pełny opis — wkrótce</p>
          </div>
        ))}
      </div>
    )}

    {cases.length > 0 && (
      <div class="mt-10 text-center">
        <a
          href="/case-studies"
          class="inline-flex items-center gap-2 border border-border hover:border-border-light text-ink-muted hover:text-ink text-sm font-medium px-6 py-3 rounded-lg transition-all"
        >
          Wszystkie case studies
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

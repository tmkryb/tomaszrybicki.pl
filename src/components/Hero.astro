---
---

<section class="relative min-h-[calc(100vh-4rem)] flex items-center overflow-hidden bg-bg">
  <!-- Subtle grid background -->
  <div class="absolute inset-0 grid-bg opacity-100"></div>

  <!-- Very subtle warm glow top-right -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full" style="background: radial-gradient(circle, rgba(232,81,30,0.05) 0%, transparent 65%)"></div>
  <!-- Subtle glow bottom-left -->
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full" style="background: radial-gradient(circle, rgba(232,81,30,0.04) 0%, transparent 65%)"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-24 w-full">
    <div class="max-w-3xl">
      <div class="section-label mb-8">
        Senior Konsultant Technologiczny & Software Architect
      </div>

      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-ink leading-[1.05] tracking-tight mb-6">
        Tomasz<br />
        <span class="text-accent">Rybicki</span>
      </h1>

      <p class="text-xl md:text-2xl text-ink font-medium leading-snug mb-5">
        Upraszczam złożone systemy.<br />
        Porządkuję architekturę.<br />
        <span class="text-ink-muted font-normal">Pomagam podejmować lepsze decyzje techniczne.</span>
      </p>

      <p class="text-ink-muted text-lg leading-relaxed mb-10 max-w-2xl">
        Pomagam firmom redukować dług technologiczny, projektować architekturę i budować solidne podstawy
        pod długoterminowy rozwój — bez odklejonych diagramów, za to z naciskiem na praktyczne wdrożenie.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#kontakt"
          class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-dark text-white font-medium px-6 py-3.5 rounded-lg transition-all duration-200 shadow-sm hover:shadow-md"
          style="--tw-shadow-color: rgba(232,81,30,0.25)"
        >
          Umów rozmowę
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="#uslugi"
          class="inline-flex items-center justify-center gap-2 border border-border hover:border-border-light text-ink-muted hover:text-ink font-medium px-6 py-3.5 rounded-lg transition-all duration-200"
        >
          Zobacz, w czym pomagam
        </a>
      </div>

      <div class="flex flex-wrap gap-10 mt-16 pt-8 border-t border-border">
        <div>
          <span class="block text-3xl font-bold text-ink tabular-nums">14+</span>
          <span class="text-ink-muted text-sm">lat w software engineering</span>
        </div>
        <div>
          <span class="block text-3xl font-bold text-ink">Enterprise</span>
          <span class="text-ink-muted text-sm">i systemy produktowe</span>
        </div>
        <div>
          <span class="block text-3xl font-bold text-ink">Full-stack</span>
          <span class="text-ink-muted text-sm">od kodu do architektury</span>
        </div>
      </div>
    </div>
  </div>
</section>

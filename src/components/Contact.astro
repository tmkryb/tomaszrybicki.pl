---
---

<section id="kontakt" class="py-24 md:py-32 relative overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-30"></div>
  <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 50% at 50% 100%, rgb(var(--color-accent) / 0.05) 0%, transparent 70%)"></div>

  <div class="relative max-w-6xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <div>
        <div class="section-label">Kontakt</div>
        <h2 class="text-3xl md:text-4xl font-bold text-ink mb-6 leading-tight">
          Porozmawiajmy o Twoim<br />systemie
        </h2>
        <p class="text-ink-muted text-lg leading-relaxed mb-8">
          Masz system, który stał się zbyt złożony? Chcesz uporządkować architekturę
          albo lepiej zrozumieć źródła długu technologicznego? Napisz.
        </p>

        <div class="space-y-4">
          <a
            href="mailto:tmkryb@gmail.com"
            class="flex items-center gap-4 p-4 bg-bg-card border border-border rounded-xl hover:border-border-light transition-colors group"
          >
            <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center text-accent flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <div class="text-ink-muted text-xs mb-0.5">Email</div>
              <div class="text-ink text-sm font-medium group-hover:text-accent transition-colors">tmkryb@gmail.com</div>
            </div>
          </a>

          <a
            href="https://www.linkedin.com/in/tomasz-rybicki/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 bg-bg-card border border-border rounded-xl hover:border-border-light transition-colors group"
          >
            <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center text-accent flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <div class="text-ink-muted text-xs mb-0.5">LinkedIn</div>
              <div class="text-ink text-sm font-medium group-hover:text-accent transition-colors">linkedin.com/in/tomasz-rybicki/</div>
            </div>
          </a>

          <div class="flex items-center gap-4 p-4 bg-bg-card border border-border rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-bg-elevated flex items-center justify-center text-accent flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <div class="text-ink-muted text-xs mb-0.5">Dostępność</div>
              <div class="text-ink text-sm font-medium">Przyjmuję nowych klientów — Q2 2026</div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-bg-card border border-border rounded-2xl p-8">
        <h3 class="text-ink font-semibold text-lg mb-6">Napisz do mnie</h3>
        <form
          id="contact-form"
          class="space-y-4"
          action="https://formspree.io/f/meerkqjo"
          method="POST"
        >
          <div>
            <label for="name" class="block text-ink-muted text-sm mb-1.5">Imię i nazwisko</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Tomasz Rybicki"
              class="w-full bg-bg-elevated border border-border rounded-lg px-4 py-3 text-ink text-sm placeholder-ink-subtle focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-ink-muted text-sm mb-1.5">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tmkryb@gmail.com"
              class="w-full bg-bg-elevated border border-border rounded-lg px-4 py-3 text-ink text-sm placeholder-ink-subtle focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <div>
            <label for="company" class="block text-ink-muted text-sm mb-1.5">Firma <span class="text-ink-subtle">(opcjonalnie)</span></label>
            <input
              type="text"
              id="company"
              name="company"
              placeholder="Twoja firma"
              class="w-full bg-bg-elevated border border-border rounded-lg px-4 py-3 text-ink text-sm placeholder-ink-subtle focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <div>
            <label for="message" class="block text-ink-muted text-sm mb-1.5">Wiadomość</label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              placeholder="Opisz krótko, czego potrzebujesz lub jaki problem chcesz rozwiązać..."
              class="w-full bg-bg-elevated border border-border rounded-lg px-4 py-3 text-ink text-sm placeholder-ink-subtle focus:outline-none focus:border-accent transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-accent hover:bg-accent-dark text-white font-medium py-3 rounded-lg transition-colors text-sm flex items-center justify-center gap-2"
          >
            Wyślij wiadomość
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
          <p class="text-ink-subtle text-xs text-center">
            Odpowiadam zazwyczaj w ciągu 1–2 dni roboczych.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple Formspree integration - swap out for your preferred form handler
  const form = document.getElementById('contact-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.textContent = 'Wysyłanie...';
      btn.disabled = true;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.innerHTML = `
            <div class="text-center py-8">
              <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center mx-auto mb-4">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgb(var(--color-accent))" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <h4 class="text-ink font-semibold mb-2">Wiadomość wysłana!</h4>
              <p class="text-ink-muted text-sm">Odezwę się do Ciebie wkrótce.</p>
            </div>
          `;
        } else {
          throw new Error('Form submission failed');
        }
      } catch {
        btn.textContent = 'Wyślij wiadomość';
        btn.disabled = false;
        alert('Coś poszło nie tak. Napisz bezpośrednio na maila.');
      }
    });
  }
</script>
